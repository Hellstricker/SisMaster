# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.

# --- Banco (SQL Server no Docker) ---
# Senha forte (mín. 8, maiúscula, minúscula, número e símbolo). Evite o caractere $ (o Compose o interpreta).
SA_PASSWORD=
DB_NAME=SisMaster

# --- Portas no computador (opcionais; os valores abaixo são os padrões) ---
# DB_PORT=1433
# API_PORT=5200
# FRONT_PORT=3000

# --- Ambiente da API (Production por padrão no Docker) ---
# ASPNETCORE_ENVIRONMENT=Production

# --- E-mail do sistema (verificação de conta, recuperação de senha, avisos de inscrição) ---
# Gmail: SMTP_USER é o endereço Gmail e SMTP_PASSWORD é uma senha de app de 16 caracteres.
# EMAIL_PROVEDOR=Log só registra no log (nada é enviado); use Smtp para enviar de verdade as senhas temporárias.
EMAIL_PROVEDOR=Log
# Endereço pelo qual as pessoas abrem o sistema (vai no link do e-mail "Esqueci minha senha").
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cofre de dados (scripts/banco/cofre.ps1): instancia SQL Server local, com Windows Authentication ---
# COFRE_SERVIDOR=NOME-DA-SUA-MAQUINA
# COFRE_PASTA_TROCA=C:\Users\Public\SisMasterCofre

# --- Acesso (login) ---
# Chave que assina os tokens (32+ caracteres, secreta). Gere uma, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=
# Administrador inicial: criado só quando ainda não existe nenhum usuário; troca de senha obrigatória no 1º acesso.
ADMIN_EMAIL=
ADMIN_NOME=Administrador
ADMIN_SENHA_INICIAL=
# Site público: sigla da associação que ele mostra (uma por instalação; padrão ABABAS).
SITE_ASSOCIACAO_SIGLA=ABABAS
