# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.

# --- Banco (SQL Server no Docker) ---
# Senha forte (mín. 8, maiúscula, minúscula, número e símbolo). Evite o caractere $ (o Compose o interpreta).
SA_PASSWORD=
DB_NAME=SisMaster

# --- Portas no computador (opcionais; os valores abaixo são os padrões) ---
# DB_PORT=1433
# API_PORT=5200
# FRONT_PORT=3000

# --- Ambiente da API (Production por padrão no Docker) ---
# ASPNETCORE_ENVIRONMENT=Production

# --- E-mail do sistema (verificação de conta, recuperação de senha, avisos de inscrição) ---
# Gmail: SMTP_USER é o endereço Gmail e SMTP_PASSWORD é uma senha de app de 16 caracteres.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cofre de dados (scripts/banco/cofre.ps1): instancia SQL Server local, com Windows Authentication ---
# COFRE_SERVIDOR=NOME-DA-SUA-MAQUINA
# COFRE_PASTA_TROCA=C:\Users\Public\SisMasterCofre
